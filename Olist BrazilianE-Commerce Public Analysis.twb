      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset+' name='federated.1o3mrtb1ksunfk0zy1uf201hhx0j' />
          </datasources>
          <datasource-dependencies datasource='federated.1o3mrtb1ksunfk0zy1uf201hhx0j'>
            <column caption='Delivery Days' datatype='integer' name='[Calculation_1809669037592580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_customer_date])' />
            </column>
            <column-instance column='[Calculation_1809669037592580]' derivation='Avg' name='[avg:Calculation_1809669037592580:qk]' pivot='key' type='quantitative' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />

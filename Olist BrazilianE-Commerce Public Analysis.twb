      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset+' name='federated.1o3mrtb1ksunfk0zy1uf201hhx0j' />
          </datasources>
          <datasource-dependencies datasource='federated.1o3mrtb1ksunfk0zy1uf201hhx0j'>
            <column caption='Fixed LOD Number of Orders per Customer' datatype='integer' name='[Calculation_1809669130862608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [customer_unique_id]: COUNTD([order_id]) }' />
            </column>
            <column caption='Fixed LOD Number of Orders per Customer (bin)' datatype='integer' name='[Fixed LOD Number of Orders per Customer (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[Calculation_1809669130862608]' peg='0' size='1' />
            </column>
            <column-instance column='[customer_unique_id]' derivation='CountD' name='[ctd:customer_unique_id:qk]' pivot='key' type='quantitative' />
            <column aggregate-role-from='[geolocation_state]' caption='Customer Unique Id' datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' />
            <column-instance column='[Fixed LOD Number of Orders per Customer (bin)]' derivation='None' name='[none:Fixed LOD Number of Orders per Customer (bin):ok]' pivot='key' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />

      <aliases enabled='yes' />
      <column caption='&quot;Order Id&quot;' datatype='string' name='[&quot;order_id&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Answer Timestamp&quot;' datatype='datetime' name='[&quot;review_answer_timestamp&quot;]' role='dimension' type='ordinal' />
      <column caption='&quot;Review Comment Message&quot;' datatype='string' name='[&quot;review_comment_message&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Comment Title&quot;' datatype='string' name='[&quot;review_comment_title&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Creation Date&quot;' datatype='string' name='[&quot;review_creation_date&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Id&quot;' datatype='string' name='[&quot;review_id&quot;]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='&quot;Review Score&quot;' datatype='integer' name='[&quot;review_score&quot;]' role='dimension' type='ordinal' />
      <column caption='Total Payment Value' datatype='real' name='[Calculation_1809669033385985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value])' />
      </column>
      <column caption='Number of Orders' datatype='integer' name='[Calculation_1809669037027330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Payment per Customer' datatype='real' name='[Calculation_1809669037252611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value]) / COUNTD([order_id])' />
      </column>
      <column caption='Delivery Days' datatype='integer' name='[Calculation_1809669037592580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_customer_date])' />
      </column>
      <column caption='If Delay?' datatype='integer' name='[Calculation_1809669037740037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Delay Rate' datatype='real' name='[Calculation_1809669037850630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1809669037740037]) / COUNTD([order_id])' />
      </column>
      <column caption='Fixed LOD Number of Orders per Customer' datatype='integer' name='[Calculation_1809669130862608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id]: COUNTD([order_id]) }' />
      </column>
      <column caption='Reviewed Payments' datatype='integer' name='[Calculation_1809669138046993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([&quot;review_score&quot;]) THEN [&quot;order_id&quot;] END)' />
      </column>
      <column caption='Cancelation Rate' datatype='real' name='[Calculation_1809669170311186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status]=&apos;canceled&apos; THEN 1 ELSE 0 END) / COUNTD([order_id])' />
      </column>
      <column caption='Repayment Rate' datatype='real' name='[Calculation_1809669173878803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1809669130862608]&gt;=2 THEN [customer_unique_id] END) / COUNTD([customer_unique_id])' />
      </column>
      <column caption='Average Delivery Time' datatype='real' name='[Calculation_1809669174435860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1809669037592580])' />
      </column>
      <column caption='Monthly Average Rating' datatype='real' name='[Calculation_1809669175402517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ FIXED [order_id]: AVG([&quot;review_score&quot;])})' />
      </column>
      <column caption='Weekdays/Weekends' datatype='string' name='[Calculation_1809669175959574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [order_purchase_timestamp]) = 1 OR &#10;   DATEPART(&apos;weekday&apos;, [order_purchase_timestamp]) = 7 &#10;THEN &apos;Weekends&apos; &#10;ELSE &apos;Weekdays&apos; &#10;END' />
      </column>
      <column caption='Daily Average Sales' datatype='real' name='[Calculation_1809669176410135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE DATETRUNC(&apos;day&apos;, [order_purchase_timestamp]): SUM([payment_value]) })' />
      </column>
      <column caption='Fixed LOD Number of Orders per Customer (bin)' datatype='integer' name='[Fixed LOD Number of Orders per Customer (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Calculation_1809669130862608]' peg='0' size='1' />
      </column>

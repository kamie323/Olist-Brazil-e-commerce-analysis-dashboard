              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1o3mrtb1ksunfk0zy1uf201hhx0j].[usr:Calculation_1809669174435860:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1o3mrtb1ksunfk0zy1uf201hhx0j].[usr:Calculation_1809669170311186:qk]&quot;' />
